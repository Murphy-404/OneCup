{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onecup-personal",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/healthz"]},
  "vars": {"APP_ORIGIN":"https://onecup-personal.YOUR-SUBDOMAIN.workers.dev","WORKSPACE_MODE":"readonly"},
  "d1_databases": [{"binding":"DB","database_name":"onecup-personal-db","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"cloudflare/migrations"}]
}
