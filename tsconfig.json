{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@onecup/edition": [
        "./src/edition.tsx"
      ],
      "@onecup/service-info": [
        "./src/components/ServiceInfo.tsx"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
