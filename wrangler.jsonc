{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onecup-personal",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://your-domain.example",
    "EMAIL_FROM": "",
    "DEV_EMAILS": "false",
    "PLAINTEXT_PASSWORD_TEST": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onecup-personal",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "env": {
    "local": {
      "name": "onecup-personal-local",
      "vars": {
        "ENVIRONMENT": "local",
        "APP_ORIGIN": "http://127.0.0.1:8787",
        "EMAIL_FROM": "local-preview@example.test",
        "DEV_EMAILS": "true",
        "PLAINTEXT_PASSWORD_TEST": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "onecup-personal-local",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "cloudflare/migrations"
        }
      ]
    }
  }
}
