{
  "name": "onecup-personal",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:server && node scripts/copy-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server-dist/index.mjs",
    "test": "tsx --test tests/*.test.ts",
    "audit:content": "tsx scripts/content-audit.ts",
    "dev:api": "tsx server/index.ts",
    "build:server": "node scripts/build-server.mjs",
    "backup": "node server-dist/cli.mjs backup",
    "restore": "node server-dist/cli.mjs restore",
    "verify:backup": "node server-dist/cli.mjs verify",
    "cf:typecheck": "tsc -p tsconfig.worker.json",
    "cf:build": "npm run build && npm run cf:typecheck",
    "cf:dry-run": "npm run cf:build && wrangler deploy --config wrangler.example.jsonc --dry-run --outdir cloudflare/.dry-run",
    "cf:deploy": "npm run cf:build && wrangler d1 migrations apply DB --remote --config wrangler.jsonc && wrangler deploy --config wrangler.jsonc",
    "test:cf": "npm run cf:dry-run && tsx --test tests/worker-cloudflare.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "miniflare": "5.20261023.1-beta",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Personal non-commercial beverage-making toolkit with attribution required",
  "license": "LicenseRef-OneCup-Personal-NC-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Murphy-404/OneCup.git"
  },
  "homepage": "https://github.com/Murphy-404/OneCup#readme",
  "bugs": {
    "url": "https://github.com/Murphy-404/OneCup/issues"
  }
}
