    {
      "id": "matcha",
      "name": "冰抹茶拿铁",
      "en": "ICED MATCHA LATTE",
      "category": "tea",
      "image": 0,
      "description": "抹茶的清新，遇上牛奶的柔软。给忙碌的日常，留一点绿色。",
      "tags": [
        "清新茶香",
        "绵柔奶感"
      ],
      "minutes": 5,
      "ingredients": [
        {
          "id": "matcha",
          "amount": 3,
          "unit": "g",
          "optional": false
        },
        {
          "id": "water",
          "amount": 40,
          "unit": "ml",
          "optional": false
        },
        {
          "id": "milk",
          "amount": 160,
          "unit": "ml",
          "optional": false
        },
        {
          "id": "syrup",
          "amount": 10,
          "unit": "ml",
          "optional": false
        },
        {
          "id": "ice",
          "amount": 100,
          "unit": "g",
          "optional": false
        }
      ],
      "steps": [
        "用 {water} 温水将 {matcha} 抹茶粉搅打至没有结块。",
        "杯中加入 {ice} 冰块、{syrup} 糖浆，倒入 {milk} 牛奶。",
        "沿冰块缓缓倒入抹茶液，欣赏分层后搅匀饮用。"
      ],
      "story": "抹茶以整片茶叶研磨成粉，与牛奶融合后，茶的微苦与奶香形成柔和的平衡。此处是适合家庭制作的冰饮版本。",
      "method": "兑制",
      "source": "家庭调配参考版本，待实际试做。",
      "alcohol": false,
      "reference": {
        "version": "2026-10-29.2",
        "status": "reference",
        "timeNote": "标注为调配参考时间，不含材料称量与清洗、制冰、杯子预冷、糖浆制作与冷却；实际耗时依设备和熟练度变化。",
        "specs": {
          "matcha": "纯抹茶粉，不是含糖抹茶饮料粉",
          "water": "饮用水；按本页标注分别量取 ml 或称量 g",
          "milk": "可直接饮用的原味牛奶",
          "syrup": "白砂糖:水按质量 1:1 的原味糖浆；冷却后按体积量取",
          "ice": "食用冰块，按质量称量，不按杯中体积推算"
        }
      },
      "toolRequirements": [
        {
          "id": "cup"
        },
        {
          "id": "measure"
        },
        {
          "id": "spoon"
        },
        {
          "id": "whisk",
          "alternatives": [
            "frother"
          ]
        },
        {
          "id": "scale",
          "optional": true,
          "note": "推荐用于准确称量克数，尤其是粉料与果肉。"
        }
      ]
    },
